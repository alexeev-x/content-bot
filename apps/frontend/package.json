{
  "name": "@alexeev/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite build && vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "explore": "playwright test --config playwright.explore.config.ts",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
