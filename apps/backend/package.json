{
  "name": "@alexeev/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../frontend/dist/client && wrangler dev --test-scheduled --assets ../frontend/dist/client --port 8790",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "npm run types && tsc --noEmit",
    "build": "npm run typecheck",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply content-bot --local",
    "db:migrate:remote": "wrangler d1 migrations apply content-bot --remote"
  },
  "dependencies": {
    "@alexeev/contracts": "*",
    "@hono/zod-validator": "^0.9.1",
    "grammy": "^1.46.0",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "~1.3.6",
    "wrangler": "^4.147.0"
  }
}
