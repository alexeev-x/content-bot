// One Worker serves the admin SPA (static assets built by Vite in apps/frontend),
// the admin API (/api/v1/*), the Telegram webhook (/webhooks/*) and the Cron dispatcher.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "content-bot",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*"]
  },
  // An empty list removes existing Cron Triggers on the next deployment. Each environment states
  // its own list, so what is scheduled never depends on how Wrangler inherits `triggers`.
  "triggers": { "crons": [] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "content-bot",
      // Placeholder for local development and tests only. Bindings are not inherited by named
      // environments: env.dev and env.production declare their own databases below.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    },
    // Hero statistics (owner, 29.10.2026): their own database, so long scans never block publishing claims. Local and
    // tests only here; production declares its own once the owner creates it; DEV never runs statistics.
    {
      "binding": "STATS_DB",
      "database_name": "content-stats",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations-stats"
    }
  ],
  // The nightly statistics: one step per hero, retried on its own; the instance id is the date, so a second Cron tick
  // cannot start the same night twice.
  "workflows": [
    { "name": "content-stats-snapshot", "binding": "STATS_SNAPSHOT", "class_name": "StatsSnapshotWorkflow" }
  ],
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "content-r2-test" }],
  // Local runs draw rubric pictures on Cloudflare's real browser (remote binding: the code stays local, the database
  // and secrets are untouched); it shares the account's free 10 browser minutes a day.
  "browser": { "binding": "BROWSER", "remote": true },
  // The bot's AI model calls (owner, 19.10.2026): a consumer has 15 min of wall time, a webhook's waitUntil 30 s.
  // Like D1, queues are not inherited: each environment names its own, which the owner creates once.
  "queues": {
    "producers": [{ "binding": "AI_JOBS", "queue": "content-ai-local" }],
    // One job at a time, no automatic retry: a model call is paid and its failure is shown in the chat.
    "consumers": [{ "queue": "content-ai-local", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 0 }]
  },
  "vars": {
    // The only Telegram user allowed to use the admin, the Mini App and bot commands.
    "OWNER_TELEGRAM_ID": "768918661",
    // Kill switch of the Cron dispatcher: only the exact string "true" lets it claim jobs.
    // Reconcile of expired leases and cleanup run regardless. The owner flips it per environment.
    "PUBLISHING_ENABLED": "false",
    // Content analytics sources (public identifiers, not secrets). Empty here so local runs and
    // tests never reach the network; YOUTUBE_API_KEY is a Worker secret the owner sets.
    "ANALYTICS_TELEGRAM_CHANNEL": "",
    "ANALYTICS_YOUTUBE_CHANNEL_ID": "",
    // Local runs only: STRATZ and OpenDota are called directly from the owner's one home address (no bridge).
    "STATS_DIRECT": "true",
    // Local runs only: every rubric sample is also kept in the local R2 (samples/…), so its result can be read back.
    "SAMPLE_MIRROR": "true"
  },

  // Cloudflare Vite plugin selects these at build time via CLOUDFLARE_ENV.
  // Bindings such as vars/D1 are not inherited by named environments, so each environment
  // explicitly owns its runtime configuration.
  "env": {
    "dev": {
      "name": "dev",
      "workers_dev": true,
      // Every minute, UTC. The dispatcher stays off until PUBLISHING_ENABLED is "true".
      "triggers": { "crons": ["* * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "content-db-dev",
          "database_id": "c54dffdc-61d1-45dc-a483-773303ba9019",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "content-r2-dev" }],
      // Rubric pictures from HTML with Valve's real icons (owner, 25.10.2026: free plan, 10 browser minutes a day).
      "browser": { "binding": "BROWSER" },
      "queues": {
        "producers": [{ "binding": "AI_JOBS", "queue": "content-ai-dev" }],
        // One job at a time, no automatic retry: a model call is paid and its failure is shown in the chat.
        "consumers": [{ "queue": "content-ai-dev", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 0 }]
      },
      "vars": {
        "OWNER_TELEGRAM_ID": "768918661",
        "PUBLISHING_ENABLED": "true",
        // Control runs of the AI writer (20+ drafts) on dev; production keeps the default 20 per 10 minutes.
        "AI_DRAFT_LIMIT": "200",
        // The owner's keyless stats bridge on Deno Deploy (bridge/stats-bridge): STRATZ refuses Cloudflare's addresses.
        "STATS_BRIDGE_URL": "https://faded-millipede-9696.alexeev-x.deno.net",
        "ANALYTICS_TELEGRAM_CHANNEL": "alexeev_x",
        "ANALYTICS_YOUTUBE_CHANNEL_ID": "UCE-VQmi1Qym7MrEzHg9ngjA"
      }
    },
    "production": {
      "name": "app",
      "workers_dev": true,
      // Every minute, UTC (owner, 24.10.2026: the first release that publishes). Without a bot token the dispatcher
      // only logs BOT_TOKEN_MISSING; reconcile, the watches and cleanup run regardless.
      "triggers": { "crons": ["* * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "content-db-prod",
          "database_id": "18d701c9-ba51-4668-b811-618ad3867670",
          "migrations_dir": "migrations"
        },
        // Hero statistics (owner, 29.10.2026; docs/backend/sources.md): created by the owner, migrations applied by
        // the owner (`wrangler d1 migrations apply content-stats-prod --remote --env production`).
        {
          "binding": "STATS_DB",
          "database_name": "content-stats-prod",
          "database_id": "8d12ced1-b2d8-41ed-b502-af89d37381cc",
          "migrations_dir": "migrations-stats"
        }
      ],
      "workflows": [
        { "name": "content-stats-snapshot-prod", "binding": "STATS_SNAPSHOT", "class_name": "StatsSnapshotWorkflow" }
      ],
      "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "content-r2-prod" }],
      "queues": {
        "producers": [{ "binding": "AI_JOBS", "queue": "content-ai-prod" }],
        // One job at a time, no automatic retry: a model call is paid and its failure is shown in the chat.
        "consumers": [{ "queue": "content-ai-prod", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 0 }]
      },
      "vars": {
        "OWNER_TELEGRAM_ID": "768918661",
        "PUBLISHING_ENABLED": "true",
        "ANALYTICS_TELEGRAM_CHANNEL": "alexeev_x",
        "ANALYTICS_YOUTUBE_CHANNEL_ID": "UCE-VQmi1Qym7MrEzHg9ngjA",
        // The owner's stats bridge to STRATZ and OpenDota (bridge/stats-bridge): with the STRATZ_TOKEN secret it turns
        // on the stats rubrics and the «Гайд на героя» match base.
        "STATS_BRIDGE_URL": "https://faded-millipede-9696.alexeev-x.deno.net"
      }
    }
  }
}
