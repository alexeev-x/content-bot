# Copy to .dev.vars (gitignored) for local development. In production the owner sets the same
# names with `npx wrangler secret put <NAME>`. The bot stays disabled (webhook answers 503 to an
# authenticated caller) until every bot setting below is present.

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Random string; the same value goes to setWebhook as secret_token.
TELEGRAM_WEBHOOK_SECRET=
# JSON of the bot's getMe result (at least id, is_bot, first_name, username), so the Worker never
# calls getMe per request. Get it once: curl https://api.telegram.org/bot<TOKEN>/getMe -> the "result" object.
BOT_INFO=
# Numeric Telegram user id of the owner (overrides the empty value in wrangler.jsonc locally).
OWNER_TELEGRAM_ID=

# Reserved for browser sign-in with Telegram OpenID Connect (not implemented yet).
TELEGRAM_OIDC_CLIENT_SECRET=
