{
  "description": "Project hooks shared with Claude Code from .agents/hooks. Codex runs them only after the owner trusts the project hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/guard-command.mjs",
            "statusMessage": "Checking command against project rules",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
