{
  "name": "content-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "check": "node scripts/check.js",
    "test": "vitest run",
    "skills": "node scripts/skills.js",
    "fix": "node scripts/check.js --fix",
    "deploy:dev": "node scripts/deploy.js dev",
    "deploy:prod": "node scripts/deploy.js production",
    "cf-typegen": "wrangler types --env dev --env-interface CloudflareBindings",
    "prepare": "husky",
    "postinstall": "wrangler types --env dev --env-interface CloudflareBindings"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,jsonc,md}": "prettier --write"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.135.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "unrs-resolver"
    ]
  }
}
