# ALEXEEV local development environment template.
# Copy to .env for local project-level values.
# Never commit .env or real secrets.
#
# The Cloudflare Worker currently reads its local secret values from
# apps/backend/.dev.vars. Keep this root file as the canonical project template.

# Telegram — DEVELOPMENT BOT ONLY
TELEGRAM_BOT_TOKEN=<YOUR_DEV_BOT_TOKEN>
TELEGRAM_WEBHOOK_SECRET=<YOUR_DEV_WEBHOOK_SECRET>
OWNER_TELEGRAM_ID=<YOUR_TELEGRAM_ID>
TELEGRAM_CHANNEL_ID=<YOUR_DEV_CHANNEL_ID>
