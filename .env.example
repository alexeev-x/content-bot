TELEGRAM_BOT_TOKEN=<YOUR_DEV_BOT_TOKEN>
TELEGRAM_WEBHOOK_SECRET=<YOUR_DEV_WEBHOOK_SECRET>
# Worker secret (Cloudflare → Workers & Pages → dev → Settings → Variables and Secrets, type Secret):
# YouTube Data API v3 key for content analytics; public counters only.
YOUTUBE_API_KEY=<YOUR_YOUTUBE_DATA_API_KEY>
# Worker secret: a GitHub token with no scopes (github.com → Settings → Developer settings → Fine-grained tokens,
# public repositories, read-only) for the game-files source; without it the source is off.
GITHUB_TOKEN=<YOUR_GITHUB_TOKEN>
