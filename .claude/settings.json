{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run check:docs)",
      "Bash(npm run agents:sync)",
      "Bash(npm run agents:check)",
      "Bash(npm test)",
      "Bash(npm run typecheck*)",
      "Bash(npm run build*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch --show-current)",
      "Bash(rg *)"
    ],
    "deny": [
      "Read(./package-lock.json)",
      "Read(./node_modules/**)",
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./.wrangler/**)",
      "Read(./**/.wrangler/**)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/.dev.vars)",
      "Read(./.agent-metrics/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.agents/hooks/guard-command.mjs\"", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.agents/hooks/log-usage.mjs\"", "timeout": 20 },
        { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.agents/hooks/verify-on-stop.mjs\"", "timeout": 320 }
      ] }
    ],
    "SubagentStop": [
      { "hooks": [
        { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.agents/hooks/log-usage.mjs\"", "timeout": 20 },
        { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/.agents/hooks/verify-on-stop.mjs\"", "timeout": 320 }
      ] }
    ]
  }
}
